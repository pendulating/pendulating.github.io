---
import DeckGLArcMapWrapper from '@components/DeckGLArcMapWrapper';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arc Map</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: transparent;
        overflow: hidden;
      }
      #map-container {
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <div id="map-container">
      <DeckGLArcMapWrapper client:only="react" />
    </div>
  </body>
</html>

