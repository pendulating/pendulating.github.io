---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import ProjectCard from "@components/ProjectCard";
import getSortedPosts from "@utils/getSortedPosts";
import { isMusicRelatedPost, mergePostsBySlug } from "@utils/flairPostSplit";
import { SITE } from "@config";
import { FLAIRS } from "@flair/config";

const flair = FLAIRS.me;
const personalPosts = await getCollection(flair.blogCollection);
const migratedMusicPosts = (await getCollection("blog")).filter(isMusicRelatedPost);
const posts = mergePostsBySlug(personalPosts, migratedMusicPosts);
const projects = await getCollection(flair.projectsCollection);

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const sortedProjects = projects.sort((a, b) => (a.data.order || Infinity) - (b.data.order || Infinity));
---

<Layout pageType="home" title={`Me | ${SITE.title}`}>
  <Header basePath="/me" />
  <main id="main-content" class="home-content pt-32 px-0">
    <div class="left-col">
      <section id="hero">
        <p>
          Welcome to the personal side of my site. This corner is for music, books, visual notes,
          and experiments that do not fit cleanly inside the academic version.
        </p>
      </section>
      <section id="featured">
        <h3 class="subsection-heading">Recent Writing</h3>
        <ul>
          {featuredPosts.map(({ data, slug }) => (
            <Card href={`/me/posts/${slug}/`} frontmatter={data} secHeading={false} />
          ))}
        </ul>
        <div class="all-posts-btn-wrapper">
          <LinkButton href="/me/posts/">
            All Posts
            <svg xmlns="http://www.w3.org/2000/svg"
              ><path
                d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
              ></path>
            </svg>
          </LinkButton>
        </div>
      </section>
    </div>
    <div class="right-col">
      <section id="selected-work">
        <h2 class="main-section-heading">Projects</h2>
        <div class="project-grid">
          {sortedProjects.map(project => <ProjectCard project={project} client:load />)}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
