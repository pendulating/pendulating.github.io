---
import { SOCIALS } from "@config";
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class={`social-icons ${centered ? "flex" : ""}`}>
  {
    SOCIALS.filter(social => social.active).map(social => (
      <LinkButton
        href={social.href}
        className="link-button-social"
        title={social.linkTitle}
      >
        <Fragment set:html={socialIcons[social.name]} />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<style>
  .social-icons {
    @apply flex-wrap justify-center gap-4; 
  }
  .link-button-social {
    @apply p-4 sm:p-4 hover:scale-110;
    transition: transform 0.2s ease, var(--theme-transition);
  }
  /* Normalize all injected SVG icon sizes and color */
  .social-icons .link-button-social svg {
    width: 24px;
    height: 24px;
    display: block;
    /* Force icons to inherit text color and ignore hardcoded fills */
    fill: currentColor !important;
    stroke: currentColor !important;
  }
  /* Some icon sets rely on stroke-width; keep it visually consistent */
  .social-icons .link-button-social svg[stroke-width] {
    stroke-width: 1.75;
  }
</style>
