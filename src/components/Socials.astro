---
import { SOCIALS } from "@config";
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

export interface Props {
  centered?: boolean;
  compact?: boolean;
  names?: string[];
}

const { centered = false, compact = false, names } = Astro.props;
const filteredSocials = SOCIALS.filter(
  social => social.active && (!names || names.includes(social.name))
);
---

<div class={`social-icons ${centered ? "flex" : ""} ${compact ? "compact" : ""}`}>
  {
    filteredSocials.map(social => (
      <LinkButton
        href={social.href}
        className="link-button-social"
        title={social.linkTitle}
      >
        <Fragment set:html={socialIcons[social.name]} />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<style>
  .social-icons {
    @apply flex-wrap justify-center gap-4; 
  }
  .link-button-social {
    @apply p-4 sm:p-4 hover:scale-110;
    transition: transform 0.2s ease, var(--theme-transition);
  }

  .social-icons.compact {
    @apply gap-2 justify-start;
  }

  .social-icons.compact .link-button-social {
    @apply p-1.5;
  }

  .social-icons.compact .link-button-social svg {
    width: 26px !important;
    height: 26px !important;
    stroke-width: 0.65 !important;
  }
  /* All SVG normalization lives in base.css to avoid duplication */
</style>
