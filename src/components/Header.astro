---
import { LOGO_IMAGE, SITE } from "@config";
import LinkButton from "./LinkButton.astro";
import Socials from "./Socials.astro";
import { toFlairPath } from "@flair/config";

export interface Props {
  activeNav?: "posts" | "tags" | "search" | "cv";
  basePath?: "/" | "/me";
}

const { activeNav, basePath = "/" } = Astro.props;
const currentPath = Astro.url.pathname;
const isMeContext =
  basePath === "/me" || currentPath === "/me" || currentPath.startsWith("/me/");
---

<header id="main-header">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="nav-container">
    <div class="top-nav-wrap">
      <div class="left-nav-section">
        <div class="logo-social-stack">
          <a href={toFlairPath(basePath, "/")} class="logo site-logo whitespace-nowrap" id="header-logo">
            {
              LOGO_IMAGE.enable ? (
                <img
                  src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
                  alt={SITE.title}
                  width={LOGO_IMAGE.width}
                  height={LOGO_IMAGE.height}
                />
              ) : (
                "Matt Franchi"
              ) 
            }
          </a>
          <Socials compact names={["Github", "LinkedIn"]} />
        </div>
        {
          isMeContext && (
            <a href="/brain/" class="brain-link" title="Brain - Visual Workspace">
              <img
                src="/assets/brain.png"
                alt="Brain"
                width="32"
                height="32"
                class="brain-icon"
              />
            </a>
          )
        }
      </div>
      <nav id="nav-menu">
        <button
          class="hamburger-menu focus-outline"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="menu-icon"
          >
            <line x1="7" y1="12" x2="21" y2="12" class="line"></line>
            <line x1="3" y1="6" x2="21" y2="6" class="line"></line>
            <line x1="12" y1="18" x2="21" y2="18" class="line"></line>
            <line x1="18" y1="6" x2="6" y2="18" class="close"></line>
            <line x1="6" y1="6" x2="18" y2="18" class="close"></line>
          </svg>
        </button>
        <ul id="menu-items">
          <li>
            <a href={toFlairPath(basePath, "/posts/")} class={activeNav === "posts" ? "active" : ""}>
              WRITING
            </a>
          </li>
          <li>
            <a href={`/assets/cv.pdf`} class={activeNav == 'cv' ? 'active' : ''}>
              CV
            </a>
          </li>
          <li>
            <LinkButton
              href={toFlairPath(basePath, "/search/")}
              className={`focus-outline p-3 sm:p-1 ${
                activeNav === "search" ? "active" : ""
              } flex`}
              ariaLabel="search"
              title="Search"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="scale-125 sm:scale-100"
              >
                <path
                  d="M19.023 16.977a35.13 35.13 0 0 1-1.367-1.384c-.372-.378-.596-.653-.596-.653l-2.8-1.337A6.962 6.962 0 0 0 16 9c0-3.859-3.14-7-7-7S2 5.141 2 9s3.14 7 7 7c1.763 0 3.37-.66 4.603-1.739l1.337 2.8s.275.224.653.596c.387.363.896.854 1.384 1.367l1.358 1.392.604.646 2.121-2.121-.646-.604c-.379-.372-.885-.866-1.391-1.36zM9 14c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5z"
                ></path>
              </svg>
              <span class="sr-only">Search</span>
            </LinkButton>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .left-nav-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-social-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.12rem;
    line-height: 1;
  }

  .logo-social-stack :global(.social-icons) {
    margin-top: -0.3rem;
  }

  #nav-menu {
    margin-top: 0.25rem;
  }

  .logo-social-stack :global(.social-icons .link-button-social svg) {
    width: 26px !important;
    height: 26px !important;
    stroke-width: 0.65 !important;
  }

  .logo-social-stack :global(.social-icons .link-button-social svg[stroke-width]),
  .logo-social-stack :global(.social-icons .link-button-social .icon-tabler) {
    stroke-width: 0.65 !important;
  }
  
  .brain-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    opacity: 0.8;
  }
  
  .brain-link:hover {
    opacity: 1;
    transform: scale(1.05);
    background-color: rgba(99, 102, 241, 0.1);
  }
  
  .brain-icon {
    display: block;
    filter: brightness(0.9);
    transition: filter 0.2s ease;
  }
  
  .brain-link:hover .brain-icon {
    filter: brightness(1.1);
  }
  
  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .left-nav-section {
      gap: 0.75rem;
    }

    .logo-social-stack :global(.social-icons) {
      margin-top: -0.2rem;
      gap: 0.35rem;
    }

    #nav-menu {
      margin-top: 0;
    }
    
    .brain-link {
      padding: 0.375rem;
    }
    
    .brain-icon {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  // Mobile menu functionality
  document.addEventListener('astro:page-load', () => {
    const hamburgerBtn = document.querySelector('.hamburger-menu');
    const menuItems = document.querySelector('#menu-items');
    const menuLinks = menuItems?.querySelectorAll('a, button');
    const menuIcon = document.querySelector('.menu-icon');
    
    // Check if we're in mobile view
    const isMobile = () => window.innerWidth < 640;
    
    // Toggle menu function (only for mobile)
    const toggleMenu = () => {
      if (!isMobile()) return;
      
      const isCurrentlyOpen = menuItems?.classList.contains('show');
      
      if (isCurrentlyOpen) {
        // Close menu
        menuItems?.classList.remove('show');
        menuIcon?.classList.remove('is-active');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        hamburgerBtn?.setAttribute('aria-label', 'Open Menu');
      } else {
        // Open menu
        menuItems?.classList.add('show');
        menuIcon?.classList.add('is-active');
        hamburgerBtn?.setAttribute('aria-expanded', 'true');
        hamburgerBtn?.setAttribute('aria-label', 'Close Menu');
      }
    };
    
    // Initialize menu state
    const initializeMenu = () => {
      if (isMobile()) {
        // Mobile: start with menu closed
        menuItems?.classList.remove('show');
        menuIcon?.classList.remove('is-active');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        hamburgerBtn?.setAttribute('aria-label', 'Open Menu');
      } else {
        // Desktop: ensure menu is accessible
        menuItems?.classList.remove('show');
        menuIcon?.classList.remove('is-active');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        hamburgerBtn?.setAttribute('aria-label', 'Open Menu');
      }
    };
    
    // Initialize on load
    initializeMenu();
    
    // Add click event to hamburger button
    hamburgerBtn?.addEventListener('click', e => {
      e.stopPropagation();
      if (isMobile()) {
        toggleMenu();
      }
    });
    
    // Close menu when clicking anywhere else (mobile only)
    document.addEventListener('click', e => {
      if (!isMobile()) return;
      
      const target = e.target as Node;
      const isMenuOpen = menuItems?.classList.contains('show');
      
      if (isMenuOpen && 
          menuItems && 
          !menuItems.contains(target) && 
          hamburgerBtn && 
          !hamburgerBtn.contains(target)) {
        toggleMenu();
      }
    });
    
    // Close menu when a menu item is clicked (mobile only)
    menuLinks?.forEach(link => {
      link.addEventListener('click', () => {
        if (isMobile() && menuItems?.classList.contains('show')) {
          toggleMenu();
        }
      });
    });
    
    // Handle resize - reinitialize menu state
    window.addEventListener('resize', () => {
      initializeMenu();
    });
    
    // Handle escape key to close menu (mobile only)
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && isMobile() && menuItems?.classList.contains('show')) {
        toggleMenu();
        (hamburgerBtn as HTMLElement)?.focus();
      }
    });
  });
</script>

